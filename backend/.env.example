# Copy this file to backend/.env and fill in the values from your
# Supabase project dashboard (Settings → API).

# REQUIRED — Supabase project URL (https://<project>.supabase.co)
SUPABASE_URL=

# REQUIRED — service role key. NEVER share this; bypass-RLS power.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL — overrides for engine/worker behaviour.
# STOCKFISH_PATH=C:/path/to/stockfish.exe
# HANGD_DEPTH_BEST=10
# HANGD_DEPTH_PLAYED=8
# HANGD_WORKER_POLL_SECS=5
# HANGD_WORKER_BATCH_SIZE=200
